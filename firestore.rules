rules_version = '2';

/**
 * MindCode security rules.
 *
 * Guiding principle: the client may write only what it fully owns and cannot
 * cheat with — its display name, avatar and settings. Everything that feeds
 * scoring, progression or leaderboards is written exclusively by the
 * `submitGameResult` Cloud Function using the Admin SDK, which bypasses these
 * rules. If a path is not explicitly allowed below, it is denied.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /** Fields the client is trusted to change on its own profile. */
    function onlyIdentityFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'avatarId', 'countryCode', 'settings', 'updatedAt']);
    }

    function validProfileCreate(uid) {
      let d = request.resource.data;
      return d.uid == uid
        && d.xp == 0
        && d.level == 1
        && d.badges.size() == 0
        && d.stats.played == 0
        && d.stats.totalScore == 0
        && d.streak.current == 0
        && d.displayName is string
        && d.displayName.size() >= 2
        && d.displayName.size() <= 20;
    }

    function validIdentityUpdate() {
      let d = request.resource.data;
      return d.displayName is string
        && d.displayName.size() >= 2
        && d.displayName.size() <= 20
        && d.avatarId is int
        && d.avatarId >= 0
        && d.avatarId <= 99;
    }

    /* ---- Profiles: private to their owner ---- */
    match /profiles/{uid} {
      allow get, list: if isOwner(uid);

      // First launch creates a zeroed profile. Any non-zero starting state is
      // an attempt to fabricate progress.
      allow create: if isOwner(uid) && validProfileCreate(uid);

      // Progression fields are function-only; the client may edit presentation.
      allow update: if isOwner(uid)
        && onlyIdentityFieldsChanged()
        && validIdentityUpdate();

      allow delete: if false; // account deletion goes through the callable

      /* Session log — written by the backend, read by its owner. */
      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      /* One Daily Challenge attempt per day. */
      match /dailyEntries/{challengeId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    /* ---- Public profile slices: world-readable, backend-written ---- */
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /* ---- Daily challenges: readable by anyone signed in ---- */
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /* ---- Leaderboards: read-only for clients ---- */
    match /leaderboards/{periodId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /entries/{uid} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    /* ---- Default deny ---- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
