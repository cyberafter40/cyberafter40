# Copy to `.env` and fill in from Firebase Console → Project settings → Your apps.
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time.
# Firebase web config values are project identifiers, not secrets: enforcement
# happens in firestore.rules and the Cloud Functions.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=mindcode-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=mindcode-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=mindcode-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# EAS
EAS_PROJECT_ID=
